# Resend API key. Leave unset to run the project without sending real email —
# the contact form still works end to end and logs the payload to the console.
RESEND_API_KEY=

# Address that receives contact-form submissions. Defaults to the address in
# site.config.ts when unset.
CONTACT_TO=contato@meridianocontabil.com.br

# Public URL of the deployment, used for metadataBase, Open Graph tags and
# sitemap.ts. Set this to the real Vercel/production URL after deploy.
NEXT_PUBLIC_SITE_URL=https://meridiano-contabilidade.vercel.app
