# Resend API key. In development, leaving it unset runs the project without
# sending real email — the contact form still works end to end and logs the
# payload to the console.
#
# In production this key is REQUIRED. Without it the API route answers 502 and
# the form tells the visitor to call instead, rather than claiming a delivery
# that never happened.
RESEND_API_KEY=

# Set to 1 to allow simulated sending even in production. Escape hatch for a
# demo or a clone that should run with no secrets at all. Leave unset on a real
# deployment.
CONTACT_SIMULATE=

# Address that receives contact-form submissions. Defaults to the address in
# site.config.ts when unset.
CONTACT_TO=contato@meridianocontabil.com.br

# Public URL of the deployment, used for metadataBase, Open Graph tags and
# sitemap.ts.
NEXT_PUBLIC_SITE_URL=https://contabilidade-institucional.vercel.app
